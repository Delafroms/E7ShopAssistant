<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 机器人运行时保持屏幕常亮：防止系统自动锁屏（熄屏后无障碍截图拿不到画面，
         机器人会因"截图失败"停摆）。普通权限，无需用户授权。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 一键开启无障碍服务：直接写 Settings.Secure 的 enabled_accessibility_services。
         这是 signature|privileged 级权限，普通安装拿不到，需要 adb 一次性授权：
             adb shell pm grant com.e7.shop android.permission.WRITE_SECURE_SETTINGS
         授权后重启/覆盖安装都保留（仅卸载重装后失效）。
         相比 Shizuku：不依赖第三方 App、插拔 USB 不会掉；相比接 Stellar 的 AIDL：
         不依赖被混淆的内部接口，它升级也不会失效。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Shizuku（可选快捷授权通道，无 Shizuku 时该功能完全静默） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".E7App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.E7Shop">

        <!-- 启动页：本身**不再带 LAUNCHER**（2026-09-20 图标三选一改造）。
             改为三个 activity-alias 指向它，运行时用 PackageManager 只启用其中一个 ——
             这样"换图标"不需要重装、也不需要多份 Activity 实现。
             三个 alias 的 icon 分别指向三套自适应图标；label 都用 app_name，
             所以在桌面看到的名称不变，只有图标随选择切换。 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.E7Shop" />

        <!-- ① 现有图标：**默认启用，且永不删除**（用户要求"别删，存着选择用"） -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".SplashActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ② E7SA 专属图标（书签 + 双点，见 drawable/ic_launcher_e7_*.xml） -->
        <activity-alias
            android:name=".IconE7"
            android:targetActivity=".SplashActivity"
            android:icon="@mipmap/ic_launcher_e7"
            android:roundIcon="@mipmap/ic_launcher_e7"
            android:label="@string/app_name"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ③ Blue Archive 风格图标（光环，自绘不含官方素材） -->
        <activity-alias
            android:name=".IconBa"
            android:targetActivity=".SplashActivity"
            android:icon="@mipmap/ic_launcher_ba"
            android:roundIcon="@mipmap/ic_launcher_ba"
            android:label="@string/app_name"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.E7Shop" />

        <activity
            android:name=".score.EquipmentScoreActivity"
            android:exported="false"
            android:label="Equipment Score"
            android:theme="@style/Theme.E7Shop" />

        <!-- Accessibility service: tap/gesture simulation -->
        <service
            android:name=".ShopAccessibilityService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- Android 14+ 要求 specialUse 类型声明子用途，否则 startForeground 抛异常 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="shop automation keep-alive while the player farms" />
        </service>

        <!-- Shizuku 通道（可选快捷授权）：**必须由 App 自己声明** ——
             dev.rikka.shizuku:provider 的 AAR 清单里并没有这个 provider（只带一个 meta-data），
             官方文档明确要求在 App 清单中声明。
             缺了它的实测后果：Shizuku.pingBinder() 恒为 false → 通道二永远不可用，
             而且 R8 会把这个类当无用代码删掉（usage.txt 里能查到）。
             android:permission 用 INTERACT_ACROSS_USERS_FULL，防止普通应用访问该 provider。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
