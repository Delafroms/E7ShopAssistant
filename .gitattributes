# 换行符规范化 —— 避免跨平台 checkout 时产生整文件 diff 噪音。
#
# 背景：本仓库在 Windows 上建立，若依赖 core.autocrlf，同一份源码在不同机器上
# 会呈现 CRLF / LF 两种形态，git diff 会把整个文件标成已修改，历史随即失去可读性。

# 源码：一律 LF（Kotlin/Java/C++ 编译器均不关心，但统一后 diff 才干净）
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.pro   text eol=lf

# Windows 脚本：必须 CRLF
# （.bat 用 LF 会让整个文件被 cmd 当成一条命令；.ps1 用 LF 在部分环境下解析异常）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制：禁止任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bin   binary
*.param binary
*.jar   binary
*.a     binary
*.so    binary
*.apk   binary
*.jks   binary
*.keystore binary
*.zstd  binary
